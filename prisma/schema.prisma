generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ponente {
  id            String   @id @default(uuid())

  nombres       String
  apellidos     String
  tipoDocumento String
  documento     String
  email         String
  telefono      String

  nombres2       String?
  apellidos2     String?
  tipoDocumento2 String?
  documento2     String?
  email2         String?
  telefono2      String?

  pais          String
  ciudad        String

  universidad   String?
  programa      String?
  semestre      String?

  grupoInvestigacion String?
  semillero          String?

  tituloPonencia String
  resumen        String
  lineaTematica  String

  ponenciaPdfUrl       String
  cesionDerechosPdfUrl String

  verificado Boolean @default(false)
  agendado   Boolean @default(false)

  agenda        PonenteAgenda[]
  asignaciones  PonenteEvaluador[]
  evaluaciones  PonenciaEvaluacion[]
  programaciones ProgramacionPonencia[]

  createdAt  DateTime @default(now())

  @@index([documento])
  @@index([email])
  @@index([universidad])
  @@index([lineaTematica])
  @@map("ponentes")
}

model PonenteAgenda {
  id        String   @id @default(uuid())
  ponenteId String
  ponente   Ponente  @relation(fields: [ponenteId], references: [id], onDelete: Cascade)

  fecha     DateTime
  inicio    String
  fin       String

  createdAt DateTime @default(now())

  @@index([ponenteId])
  @@map("ponentes_agenda")
}

model Evaluador {
  id            String   @id @default(uuid())

  nombres       String
  apellidos     String
  tipoDocumento String
  documento     String
  email         String
  telefono      String

  pais          String
  ciudad        String

  universidad   String

  profesion           String
  posgrado            String
  universidadPosgrado String

  esDocente           String
  programaDocencia    String?
  universidadDocencia String?

  verificado Boolean @default(false)
  agendado   Boolean @default(false)

  agenda        EvaluadorAgenda[]
  asignaciones  PonenteEvaluador[]
  evaluaciones  PonenciaEvaluacion[]

  createdAt  DateTime @default(now())

  @@index([documento])
  @@index([email])
  @@index([universidad])
  @@index([universidadPosgrado])
  @@index([universidadDocencia])
  @@map("evaluadores")
}

model EvaluadorAgenda {
  id          String    @id @default(uuid())
  evaluadorId String
  evaluador   Evaluador @relation(fields: [evaluadorId], references: [id], onDelete: Cascade)

  fecha     DateTime
  inicio    String
  fin       String

  createdAt DateTime @default(now())

  @@index([evaluadorId])
  @@map("evaluadores_agenda")
}

model Asistente {
  id            String   @id @default(uuid())

  nombres       String
  apellidos     String
  tipoDocumento String
  documento     String
  email         String
  telefono      String

  pais          String
  ciudad        String

  universidad   String?
  programa      String?
  semestre      String?

  createdAt     DateTime @default(now())

  @@index([documento])
  @@index([email])
  @@index([universidad])
  @@map("asistentes")
}

model PonenteEvaluador {
  id          String    @id @default(uuid())

  ponenteId   String
  evaluadorId String

  activo      Boolean   @default(true)
  assignedAt  DateTime  @default(now())

  ponente     Ponente   @relation(fields: [ponenteId], references: [id], onDelete: Cascade)
  evaluador   Evaluador @relation(fields: [evaluadorId], references: [id], onDelete: Cascade)

  evaluacion  PonenciaEvaluacion?

  @@unique([ponenteId, evaluadorId])
  @@index([ponenteId])
  @@index([evaluadorId])
  @@map("ponentes_evaluadores")
}

model PonenciaEvaluacion {
  id            String            @id @default(uuid())
  asignacionId  String            @unique

  ponenteId     String
  evaluadorId   String

  puntaje       Float?
  concepto      String?
  observaciones String?
  decision      String?
  estado        String            @default("BORRADOR")

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  asignacion    PonenteEvaluador  @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  ponente       Ponente           @relation(fields: [ponenteId], references: [id], onDelete: Cascade)
  evaluador     Evaluador         @relation(fields: [evaluadorId], references: [id], onDelete: Cascade)

  @@index([ponenteId])
  @@index([evaluadorId])
  @@index([estado])
  @@map("ponencias_evaluaciones")
}

model Salon {
  id               String   @id @default(uuid())
  nombre           String
  capacidadPonente Int
  activo           Boolean  @default(true)

  programaciones   ProgramacionPonencia[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([nombre])
  @@map("salones")
}

model AsistenciaConfig {
  id         String   @id @default(uuid())
  habilitado Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("asistencias_config")
}

model AsistenciaRegistro {
  id                   String    @id @default(uuid())
  role                 String
  nombres              String
  apellidos            String
  tipoDocumento        String
  documento            String
  email                String
  telefono             String
  institucion          String
  ciudad               String
  semillero            String?
  tituloPonencia       String?
  ponenciasEvaluadas   Json?
  source               String    @default("direct")
  certificateStatus    String    @default("pending")
  certificateSentAt    DateTime?
  certificateError     String?
  linkedRegistrationId String?
  certificateUrl       String?
  certificatePublicId  String?
  createdAt            DateTime  @default(now())

  @@index([role])
  @@index([documento])
  @@index([certificateStatus])
  @@map("asistencias_registros")
}

model ProgramacionPonencia {
  id         String   @id @default(uuid())

  ponenteId  String   @unique
  salonId    String

  fecha      DateTime
  inicio     String
  fin        String

  assignedAt DateTime @default(now())

  ponente    Ponente  @relation(fields: [ponenteId], references: [id], onDelete: Cascade)
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([fecha])
  @@index([ponenteId])
  @@map("programacion_ponencias")
}
